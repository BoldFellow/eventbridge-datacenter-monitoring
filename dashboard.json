{
    "widgets": [
        {
            "type": "text",
            "x": 0, "y": 0, "width": 24, "height": 2,
            "properties": {
                "markdown": "# Datacenter Monitoring Telemetry\nEvents flow: **Simulator → telemetry-bus → Rules → Lambda / SNS / SQS**. Rule invocations climb every 2 minutes as the simulator fires. Alarm goes IN_ALARM when messages sit in the security review queue."
            }
        },
        {
            "type": "metric",
            "x": 0, "y": 2, "width": 24, "height": 6,
            "properties": {
                "title": "EventBridge Rule Invocations (events matched per minute)",
                "view": "timeSeries",
                "stacked": false,
                "region": "us-east-1",
                "stat": "Sum",
                "period": 60,
                "annotations": {"horizontal": []},
                "metrics": [
                    ["AWS/Events", "Invocations", "RuleName", "dc-all-readings",     "EventBusName", "dc-telemetry-bus", {"label": "All readings (catch-all)",     "color": "#1f77b4"}],
                    ["AWS/Events", "Invocations", "RuleName", "dc-high-temperature", "EventBusName", "dc-telemetry-bus", {"label": "High temperature (>80C)",      "color": "#d62728"}],
                    ["AWS/Events", "Invocations", "RuleName", "dc-restricted-motion","EventBusName", "dc-telemetry-bus", {"label": "Restricted zone motion",        "color": "#ff7f0e"}],
                    ["AWS/Events", "Invocations", "RuleName", "dc-energy-spike",     "EventBusName", "dc-telemetry-bus", {"label": "Energy spike (>50 kWh)",        "color": "#9467bd"}]
                ]
            }
        },
        {
            "type": "metric",
            "x": 0, "y": 8, "width": 12, "height": 6,
            "properties": {
                "title": "Lambda Invocations",
                "view": "timeSeries",
                "stacked": false,
                "region": "us-east-1",
                "stat": "Sum",
                "period": 60,
                "annotations": {"horizontal": []},
                "metrics": [
                    ["AWS/Lambda", "Invocations", "FunctionName", "dc-simulator",       {"label": "simulator",       "color": "#1f77b4"}],
                    ["AWS/Lambda", "Invocations", "FunctionName", "dc-recorder",        {"label": "recorder",        "color": "#2ca02c"}],
                    ["AWS/Lambda", "Invocations", "FunctionName", "dc-anomaly-handler", {"label": "anomaly-handler", "color": "#9467bd"}],
                    ["AWS/Lambda", "Invocations", "FunctionName", "dc-daily-summary",   {"label": "daily-summary",   "color": "#8c564b"}]
                ]
            }
        },
        {
            "type": "metric",
            "x": 12, "y": 8, "width": 12, "height": 6,
            "properties": {
                "title": "Lambda Errors (should stay at 0)",
                "view": "timeSeries",
                "stacked": false,
                "region": "us-east-1",
                "stat": "Sum",
                "period": 60,
                "annotations": {"horizontal": [{"label": "Any error is a problem", "value": 1, "color": "#d62728"}]},
                "metrics": [
                    ["AWS/Lambda", "Errors", "FunctionName", "dc-simulator",       {"label": "simulator errors",       "color": "#d62728"}],
                    ["AWS/Lambda", "Errors", "FunctionName", "dc-recorder",        {"label": "recorder errors",        "color": "#ff7f0e"}],
                    ["AWS/Lambda", "Errors", "FunctionName", "dc-anomaly-handler", {"label": "anomaly-handler errors", "color": "#9467bd"}],
                    ["AWS/Lambda", "Errors", "FunctionName", "dc-daily-summary",   {"label": "daily-summary errors",   "color": "#8c564b"}]
                ]
            }
        },
        {
            "type": "metric",
            "x": 0, "y": 14, "width": 12, "height": 6,
            "properties": {
                "title": "DynamoDB Writes",
                "view": "timeSeries",
                "stacked": false,
                "region": "us-east-1",
                "stat": "Sum",
                "period": 60,
                "annotations": {"horizontal": []},
                "metrics": [
                    ["AWS/DynamoDB", "ConsumedWriteCapacityUnits", "TableName", "dc-readings",  {"label": "dc-readings (all events)",    "color": "#1f77b4"}],
                    ["AWS/DynamoDB", "ConsumedWriteCapacityUnits", "TableName", "dc-anomalies", {"label": "dc-anomalies (energy spikes)","color": "#9467bd"}]
                ]
            }
        },
        {
            "type": "metric",
            "x": 12, "y": 14, "width": 8, "height": 6,
            "properties": {
                "title": "Security Review Queue — Messages Pending",
                "view": "timeSeries",
                "stacked": false,
                "region": "us-east-1",
                "stat": "Maximum",
                "period": 60,
                "annotations": {"horizontal": [{"label": "Alarm threshold", "value": 1, "color": "#d62728"}]},
                "metrics": [
                    ["AWS/SQS", "ApproximateNumberOfMessagesVisible", "QueueName", "dc-security-review-queue", {"label": "Messages waiting for review", "color": "#ff7f0e"}]
                ]
            }
        },
        {
            "type": "alarm",
            "x": 20, "y": 14, "width": 4, "height": 6,
            "properties": {
                "title": "Security Review Alarm",
                "alarms": ["arn:aws:cloudwatch:us-east-1:772886489592:alarm:dc-security-review-pending"]
            }
        },
        {
            "type": "metric",
            "x": 0, "y": 20, "width": 24, "height": 4,
            "properties": {
                "title": "SNS Messages Published (temperature alerts + alarm notifications + daily summary)",
                "view": "timeSeries",
                "stacked": false,
                "region": "us-east-1",
                "stat": "Sum",
                "period": 60,
                "annotations": {"horizontal": []},
                "metrics": [
                    ["AWS/SNS", "NumberOfMessagesPublished", "TopicName", "datacenter-alerts", {"label": "datacenter-alerts", "color": "#d62728"}]
                ]
            }
        }
    ]
}
